# Manifiesto de distribución de arma3-sqf-skill

# Inclusiones explícitas
include README.md
include INSTALL.md
include README-INSTALL.md
include COMPATIBILITY-REPORT.md
include TRACEABILITY.md
include LICENSE
include CONTRIBUTING.md
include CHANGELOG.md
include pyproject.toml
include requirements.txt
include requirements-dev.txt

recursive-include skills/arma3-sqf-skill *.md *.py *.txt *.yaml *.sh
include skills/arma3-sqf-skill/agents/openai.yaml
include skills/arma3-sqf-skill/references/lens-*.md
recursive-include integrations *.md *.json
recursive-include scripts *.py *.json
recursive-include docs *.md
recursive-include evals *.py *.md *.json *.sqf *.ext
recursive-include tests *.py *.json

# Exclusiones de empaquetado (deben ir DESPUÉS de las inclusiones para tener efecto en setuptools)
prune legacy
prune evals/runs
prune .pytest_cache
prune .ruff_cache
prune __pycache__
prune */__pycache__
prune */*/__pycache__

global-exclude *.py[cod]
global-exclude *.db *.sqlite *.db-journal *.db-wal
global-exclude *.bak *.tmp *.log

exclude skills/arma3-sqf-skill/scripts/mcp_server.py
exclude skills/arma3-sqf-skill/references/run_sqflint.py
prune skills/arma3-sqf-skill/references/lenses
exclude tests/test_mcp_server.py
exclude PLAN-IMPROVEMENTS*.md
exclude PLAN-PR*.md
exclude docs/INSTRUCCION-ANTIGRAVITY-PR*.md
